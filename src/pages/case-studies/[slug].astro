---
//@ts-nocheck
import { getCaseStudies } from "@lib/api";
import { Image } from "astro:assets";
import Layout from "@layouts/Layout.astro";
import HeroClean from "@components/HeroClean.astro";

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();

  return caseStudies.map((caseStudy) => ({
    params: { slug: caseStudy.slug },
    props: { caseStudy },
  }));
}

const { caseStudy } = Astro.props;
const { caseName, category, date, image, buttonLabel } = caseStudy.caseDetails;
---

<Layout>
  <HeroClean
    eyebrowText="CASE STUDIES"
    title="Taxes & Efficiency"
    subtitle="Our achievements reflect the close collaboration between our expert teams and our esteemed clientele. We cultivate a workplace that champions peak performance and guarantees client satisfaction."
  />
  <article class="case-story-article">
    <header>
      <Image
        src={image.src}
        alt={image.alt}
        width={image.width}
        height={image.height}
      />

      <div class="case-details">
        <dl>
          <div>
            <dt>Case Name</dt>
            <dd>{caseName}</dd>
          </div>
          <div>
            <dt>Category</dt>
            <dd class="category">{category}</dd>
          </div>
          <div>
            <dt>Date</dt>
            <dd class="date">{date}</dd>
          </div>
        </dl>
        <a href="#0" class="button">{buttonLabel}</a>
      </div>
    </header>
    <section class="case-story-content">
      {
        caseStudy.sections.map((section, index) => (
          <>
            {index === 0 ? <h2>{section.title}</h2> : <h3>{section.title}</h3>}

            {Array.isArray(section.content) ? (
              <>
                {section.content.map((item) => (
                  <p>{item}</p>
                ))}
              </>
            ) : (
              <p>{section.content}</p>
            )}
            {section.highlights && (
              <ul>
                {section.highlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            )}
            {section.image && (
              <figure>
                <Image
                  src={section.image.src}
                  alt={section.image.alt}
                  width={section.image.width}
                  height={section.image.height}
                />
                {section.image.caption && (
                  <figcaption>{section.image.caption}</figcaption>
                )}
              </figure>
            )}
          </>
        ))
      }
    </section>
  </article>
</Layout>

<style>
  .case-story-article {
    display: grid;
    grid-template-columns:
      [breakout-start] minmax(0, 1fr)
      [content-start] minmax(0, 800px)
      [content-end] minmax(0, 1fr)
      [breakout-end];
    row-gap: var(--space-8);
    margin: var(--space-11) 0;

    > * {
      grid-column: content;
    }

    > header {
      grid-column: breakout;
      display: grid;
      grid-template-columns: subgrid;

      img {
        grid-column: breakout;
        width: 100%;
        height: auto;
        border-radius: var(--border-img);
      }

      .case-details {
        grid-column: content;
      }
    }

    > .case-story-content {
      grid-column: breakout;
      display: grid;
      grid-template-columns: subgrid;

      > * {
        grid-column: content;
      }

      > * + * {
        margin-top: var(--space-4);
      }

      > figure {
        grid-column: breakout;
        display: grid;
        grid-template-columns: subgrid;
        margin-block: var(--space-8) 0;
        margin-inline: 0;

        img {
          grid-column: breakout;
          grid-row: 1;
          width: 100%;
          height: auto;
        }

        &::after {
          content: "";
          grid-column: breakout;
          grid-row: 1;
          align-self: end;
          height: 40%;
          background: linear-gradient(to top, rgb(0 0 0 / 1), transparent);
        }

        figcaption {
          grid-column: content;
          grid-row: 1;
          align-self: end;
          z-index: 1;
          padding-bottom: var(--space-5);
          font-size: var(--text-size-xs);
          color: var(--color-on-ui-primary);
        }
      }

      img {
        grid-column: breakout;
        width: 100%;
        height: auto;
      }

      figcaption {
        grid-column: content;
        margin-top: var(--space-3);
        font-size: var(--text-size-xs);
        color: var(--color-text-muted);
      }
    }

    h3 {
      margin-top: var(--space-8);
    }

    p,
    li {
      color: var(--color-text-muted);
    }
  }

  .case-details {
    position: relative;
    margin-top: -3rem;
    padding: var(--space-5) var(--space-6);
    border-radius: var(--border-card);
    background-color: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-5);

    dl {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-8);
      margin: 0;
    }

    dt {
      font-weight: var(--text-bold);
    }

    dd {
      margin: 0;
      color: var(--color-text-weak);
      font-size: var(--text-size-xs);
    }

    .button {
      background-color: var(--color-action);
      color: var(--color-text);
      text-decoration: none;
      border-radius: var(--border-popover-button);
      padding: 0.5em 1.25em;
    }
  }

  @media (max-width: 600px) {
    .case-details {
      margin-top: -2rem;

      dl {
        gap: var(--space-5);
      }
    }
  }
</style>
