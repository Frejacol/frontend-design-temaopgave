---
import Faq from "@components/Faq.astro";
import Layout from "@layouts/Layout.astro";
import InfocardsSection from "@sections/InfocardsSection.astro";
import OurVision from "@sections/OurVision.astro";
import HeroClean from "@components/HeroClean.astro";
---

<Layout>
  <main>
    <HeroClean
      eyebrowText="ABOUT"
      line="right"
      title="Igniting Innovation"
      subtitle="Our strength lies in the collaboration between our talented teams and esteemed clients. We cultivate a workplace that champions innovation, promotes peak performance, and guarantees client satisfaction."
    />
    <OurVision />
    <InfocardsSection theme="grey" cardVariant="white" />
    <Faq />
  </main>
</Layout>
