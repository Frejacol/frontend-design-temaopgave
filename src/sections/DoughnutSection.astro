---
import DoughnutChart from "../components/DoughnutChart.astro";
import Section from "@components/Section.astro";
import { getExperience } from "@lib/api";
import SectionHeader from "@components/SectionHeader.astro";
const data = await getExperience();
const { title, eyebrow, subtitle, stats } = data;
---

<Section theme="yellow">
  <div class="chartContainer">
    <div class="sectionHeader">
      <SectionHeader eyebrowText={eyebrow} title={title} subtitle={subtitle} />
    </div>

    <div class="chart-grid" scroll-trigger>
      {
        stats.map((stat: any) => (
          <DoughnutChart figNumber={stat.value} figText={stat.label} />
        ))
      }
    </div>
  </div>
</Section>

<style>
  @layer components {
    .chartContainer {
      display: flex;
      width: 100%;
      gap: 89px;
      align-items: center;
      margin-inline: auto;

      animation: --switch linear both;
      animation-timeline: view();
      animation-range: 12.5% 25%;
    }

    .sectionHeader {
      width: 375px;
      align-self: flex-start;
    }

    .chart-grid {
      flex: 1;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 2rem;
    }

    .sectionHeader :global(p:last-child) {
      color: var(--color-text);
    }

    @media (max-width: 768px) {
      .chartContainer {
        flex-direction: column;
        gap: var(--space-9);
      }

      .chartContainer > div:first-child {
        flex: 0 0 auto;
      }
    }

    @keyframes --switch {
      from {
        --sentinel: 0;
      }
      to {
        --sentinel: 1;
      }
    }
  }
</style>
