---
import "@styles/main.css";
import SectionHeader from "@components/SectionHeader.astro";
import Section from "@components/Section.astro";
import FigureGraphic from "@components/FigureGraphic.astro";
import { Image } from "astro:assets";
import PhoneIcon from "@icons/phone.svg";
import ClockIcon from "@icons/clock.svg";
import LocationIcon from "@icons/pin.svg";
import ContactUsImage1 from "@assets/images/ContactUs1.jpg";
import ContactUsImage2 from "@assets/images/ContactUs2.jpg";
import ContactUsImage3 from "@assets/images/ContactUs3.jpg";
---

<Section>
  <div class="grid">
    <div>
      <SectionHeader
        eyebrowText="Process"
        title="Contact us. It's easy"
        subtitle="Leverage agile frameworks to provide a robust synopsis for high level overviews. Iterative approaches to corporate strategy foster collaborative."
      />
      <ul class="contact-list">
        <li class="yellow">
          <span class="icon"><PhoneIcon /></span>
          <div>
            <p class="label">Call Today</p>
            <a class="value" href="tel:+1800100900">+1 800 100 900</a>
          </div>
        </li>
        <li class="green">
          <span class="icon"><ClockIcon /></span>
          <div>
            <p class="label">Monday To Friday</p>
            <p class="value">9AM - 5PM</p>
          </div>
        </li>
        <li class="gray">
          <span class="icon"><LocationIcon /></span>
          <div>
            <p class="label">USA Office</p>
            <address class="value">195 Devonshire St Boston, MA 02110</address>
          </div>
        </li>
      </ul>
    </div>
    <FigureGraphic variant="bottomLeft">
      <div class="grid2">
        <Image src={ContactUsImage1} alt="" class="image1" />
        <Image src={ContactUsImage2} alt="" class="image2" />
        <Image src={ContactUsImage3} alt="" class="image3" />
      </div>
    </FigureGraphic>
  </div>
</Section>

<style>
  @layer components {
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);

      @media (max-width: 600px) {
        grid-template-columns: 1fr;

        --square-width: 45%;
        --square-height: 40%;
        --square-offset-x: -1rem;
        --square-offset-y: -1rem;
      }
    }

    .grid2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: var(--space-5);

      @media (max-width: 600px) {
        gap: var(--space-3);
      }
    }

    .image1 {
      grid-column: 1;
      grid-row: 1 / 3;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .grid2 img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .image3 {
      grid-column: 2;
      grid-row: 2;
    }

    .contact-list {
      list-style: none;
      padding: 0;
      display: grid;
      gap: var(--space-7);

      li {
        display: grid;
        grid-template-columns: auto 1fr;
        column-gap: var(--space-5);
        align-items: center;
      }

      .icon {
        display: grid;
        place-items: center;
        width: var(--space-7);
        aspect-ratio: 1;
        border-radius: 50%;
        background-color: var(--circle-bg);
        color: var(--circle-color);

        svg {
          width: var(--space-5);
          height: var(--space-5);
        }
      }

      .label {
        color: var(--color-text-muted);
        margin: 0;
      }

      .value {
        font-weight: var(--text-medium);
        font-style: normal;
        text-decoration: none;
        margin: 0;
      }

      .yellow {
        --circle-bg: #fcefc4;
        --circle-color: #d9a93a;
      }

      .green {
        --circle-bg: #b6ecaa;
        --circle-color: #4f9a45;
      }

      .gray {
        --circle-bg: #ececec;
        --circle-color: var(--color-text);
      }
    }
  }
</style>
