---
import Card from "../components/Card.astro";
import Section from "@components/Section.astro";
import { getCoreValues } from "@lib/api";
import SectionHeader from "@components/SectionHeader.astro";

const { theme = "dark", cardVariant = "light" } = Astro.props;

const data = await getCoreValues();
const { title, eyebrow, subtitle, values, button } = data;
---

<Section theme={theme}>
  <div class="grid">
    <SectionHeader eyebrowText={eyebrow} title={title} subtitle={subtitle} />
    <a href={button.link} class="button">{button.text}</a>
  </div>
  <div class="cards">
    {
      values.map((value: any) => (
        <Card
          variant={cardVariant}
          circleIcon={true}
          icon={value.icon}
          title={value.title}
          description={value.description}
          link={value.link.url}
          linkText={value.link.text}
        />
      ))
    }
  </div>
</Section>

<style>
  @layer components {
    .grid {
      display: grid;
      grid-template-columns: 1fr 1fr;

      a {
        background-color: var(--color-surface-secondary);
        border: none;
        border-radius: var(--border-button);
        cursor: pointer;
        text-decoration: none;
        color: var(--color-text);
        place-self: end;
        padding: 15px 34px;
      }
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-6);
      margin-top: var(--space-8);
      align-items: start;
    }

    @media (max-width: 600px) {
      .grid {
        grid-template-columns: 1fr;
        row-gap: var(--space-6);

        a {
          place-self: start;
        }
      }

      .cards {
        grid-template-columns: 1fr;
        gap: var(--space-4);
        margin-top: var(--space-6);
      }
    }
  }
</style>
