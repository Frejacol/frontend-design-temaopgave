---
import "@styles/main.css";

const links = [
  { href: "/", label: "Home" },
  { href: "/case-studies/taxes-and-efficiency", label: "Case Studies" },
  { href: "/team", label: "Team" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header>
  <div>
    <p>Ask<span>Experts</span></p>
    <ul>
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button>Login</button>
  </div>
</header>

<style>
  header {
    background-color: var(--color-ui-primary);

    div {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      column-gap: 1rem;
      padding: 1em 2em;
      align-items: center;

      p {
        font-weight: 600;
        color: var(--color-on-ui-primary);
        font-size: 1.5em;

        span {
          color: var(--color-action);
        }
      }

      ul {
        display: flex;
        justify-content: space-between;
        text-decoration: none;
        list-style-type: none;
        padding: 0;

        li:not(:last-child) {
          margin-right: 2em;
        }

        li {
          a {
            text-decoration: none;
            color: var(--color-on-ui-primary);
            position: relative;

            &::after {
              content: "";
              position: absolute;
              left: 0;
              bottom: -0.25em;
              width: 100%;
              height: 3px;
              border-radius: 2px;
              background-color: var(--color-action);
              transform: scaleX(0);
              transform-origin: left;
              transition: transform 250ms ease-out;
            }

            &:hover::after,
            &:focus-visible::after,
            &[aria-current="page"]::after {
              transform: scaleX(1);
            }
          }
        }
      }

      button {
        background-color: var(--color-on-ui-primary);
        color: var(--color-text);
        border-radius: 999px;
        padding: 4px 16px;
        border: none;
        width: 94px;
        justify-self: end;
      }
    }
  }
</style>
