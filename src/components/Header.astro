---
import "@styles/main.css";
import LoginPopover from "./LoginPopover.astro";

const links = [
  { href: "/", label: "Home" },
  { href: "/case-studies/taxes-and-efficiency", label: "Case Studies" },
  { href: "/team", label: "Team" },
  { href: "/about", label: "About" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header>
  <div>
    <p>Ask<span>Experts</span></p>
    <button
      class="menu-toggle"
      aria-expanded="false"
      aria-controls="main-nav"
      aria-label="Åbn menu"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
    <ul id="main-nav">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={currentPath === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
    <LoginPopover />
  </div>
</header>

<script>
  const toggle = document.querySelector(".menu-toggle");

  toggle?.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!isOpen));
  });
</script>

<style>
  @layer components {
    :global(html) {
      container: doc / scroll-state;
    }

    header {
      background-color: var(--color-ui-primary);
      position: sticky;
      inset-block-start: 0;
      z-index: 100;
      transition: translate 0.3s;
      view-timeline-name: header;
      @container scroll-state(scrolled: bottom) {
        translate: 0 -100%;
      }
    }
    div {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      column-gap: 1rem;
      padding: 1em 2em;
      align-items: center;

      p {
        font-weight: 600;
        color: var(--color-on-ui-primary);
        font-size: 1.5em;

        span {
          color: var(--color-action);
        }
      }

      ul {
        display: flex;
        justify-content: space-between;
        text-decoration: none;
        list-style-type: none;
        padding: 0;

        li:not(:last-child) {
          margin-right: 2em;
        }

        li {
          a {
            text-decoration: none;
            color: var(--color-on-ui-primary);
            position: relative;

            &::after {
              content: "";
              position: absolute;
              left: 0;
              bottom: -0.25em;
              width: 100%;
              height: 3px;
              border-radius: 2px;
              background-color: var(--color-action);
              transform: scaleX(0);
              transform-origin: left;
              transition: transform 250ms ease-out;
            }

            &:hover::after,
            &:focus-visible::after,
            &[aria-current="page"]::after {
              transform: scaleX(1);
            }
          }
        }
      }

      .login {
        background-color: var(--color-on-ui-primary);
        color: var(--color-text);
        border-radius: 999px;
        padding: 4px 16px;
        border: none;
        width: 94px;
        justify-self: end;
      }

      .menu-toggle {
        display: none;
        background: none;
        border: none;
        color: var(--color-on-ui-primary);
        cursor: pointer;
        justify-self: end;
      }

      @media (max-width: 600px) {
        grid-template-columns: 1fr auto;
        row-gap: 1rem;

        .menu-toggle {
          display: block;
        }

        ul,
        .login {
          display: none;
          grid-column: 1 / -1;
        }

        ul li:not(:last-child) {
          margin-right: 0;
        }

        &:has(.menu-toggle[aria-expanded="true"]) {
          ul {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            border-top: 1px solid #2b3a58;
            padding-top: 1rem;
            margin: 0;
          }

          .login {
            display: block;
            justify-self: start;
          }
        }
      }
    }
  }
</style>
