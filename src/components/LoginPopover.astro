---

---

<button class="login" popovertarget="loginPopover">Login</button>

<div id="loginPopover" popover>
  <form>
    <h3>Dashboard Login</h3>
    <div class="formGroup">
      <label for="email">Email address</label>
      <input type="email" />
    </div>
    <div class="formGroup">
      <label for="password">Password</label>
      <input type="password" />
    </div>
    <button type="submit">Go To Dashboard</button>
  </form>
</div>

<style>
  @layer components {
    .login {
      background-color: var(--color-on-ui-primary);
      color: var(--color-text);
      border-radius: 999px;
      padding: 4px 16px;
      border: none;
      width: 94px;
      justify-self: end;
    }

    [popover] {
      position-area: bottom span-left;
      margin: 0;
      margin-top: var(--space-4);
      inset: auto;
      overflow: visible;
      padding: var(--space-6);
      border: none;
      border-radius: var(--border-card);
      background-color: var(--color-surface-secondary);
      color: var(--color-text);
      box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.2);

      &::before {
        content: "";
        position: absolute;
        top: -0.6rem;
        right: 2.5rem;
        width: 1.25rem;
        height: 0.6rem;
        background-color: inherit;
        clip-path: polygon(50% 0, 100% 100%, 0 100%);
      }

      &::backdrop {
        background-color: rgb(0 0 0 / 0.2);
      }
    }

    form {
      display: grid;
      gap: var(--space-5);

      h3 {
        text-align: center;
        margin: 0 0 var(--space-3);
      }
    }

    .formGroup {
      display: grid;
      gap: var(--space-2);

      label {
        color: var(--color-text);
      }

      input {
        padding: var(--space-4) var(--space-5);
        border: 1px solid #b1b1b1;
        border-radius: var(--border-popover-button);
        background-color: var(--color-surface-primary);
        color: var(--color-text);

        &:focus-visible {
          outline: 2px solid var(--color-action);
          outline-offset: 2px;
        }
      }
    }

    button[type="submit"] {
      font-weight: var(--text-light);
      padding: var(--space-4);
      margin-top: var(--space-2);
      border: none;
      border-radius: var(--border-popover-button);
      background-color: var(--color-action);
      color: var(--color-text);
      cursor: pointer;
    }

    form > * {
      transition: 0.5s;
      transition-delay: calc(sibling-index() * 0.1s);
      transition-timing-function: linear(
        0,
        0.013 1%,
        0.051 2.2%,
        0.404 9.8%,
        0.51 12.6%,
        0.602 15.5%,
        0.683 18.7%,
        0.754 22.2%,
        0.813 26%,
        0.861 30.2%,
        0.9 34.8%,
        0.931 40%,
        0.972 52.7%,
        0.992 70.2%,
        1
      );
      @starting-style {
        translate: 0 2rem;
        opacity: 0;
      }
    }
  }
</style>
