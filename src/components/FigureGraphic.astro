---
import "@styles/main.css";
const { variant } = Astro.props;
---

<figure class={variant}>
  <slot />
</figure>

<style>
  @layer components {
    figure {
      position: relative;
      isolation: isolate;
      max-width: 100%;

      --square-width: 120px;
      --square-height: 100px;
      --square-offset-x: -2rem;
      --square-offset-y: -2rem;

      img {
        border-radius: var(--border-img);
      }

      &:is(.topLeft, .topRight, .bottomLeft, .topLeftLong)::before {
        content: "";
        position: absolute;
        width: var(--square-width);
        height: var(--square-height);
        background: var(--color-ui-secondary);
        z-index: -1;
        border-radius: var(--border-graphic);
      }

      &.bottomLeft::before {
        --square-width: 285px;
        --square-height: 164px;
        --square-offset-x: -65px;
        bottom: var(--square-offset-y);
        left: var(--square-offset-x);
      }

      &.topLeft::before {
        --square-width: 183px;
        --square-height: 164px;
        top: var(--square-offset-y);
        left: var(--square-offset-x);
      }

      &.topRight::before {
        --square-width: 233px;
        --square-height: 164px;
        top: var(--square-offset-y);
        right: var(--square-offset-x);
      }

      &.topLeftLong::before {
        --square-width: 233px;
        --square-height: 164px;
        top: var(--square-offset-y);
        left: var(--square-offset-x);
      }

      @media (max-width: 600px) {
        &:has(> :global(img)) {
          aspect-ratio: 16 / 10;
        }

        &:is(.topLeft, .topRight, .bottomLeft, .topLeftLong)::before {
          --square-width: 45%;
          --square-height: 50%;
          --square-offset-x: -1rem;
          --square-offset-y: -1rem;
        }
      }
    }
  }
</style>
