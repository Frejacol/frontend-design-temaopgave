---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import Button from "../components/Button.astro";
import Arrow from "../icons/arrow--right.svg";
---

<section class="hero">
  <div class="hero-background"></div>
  <div class="hero-content">
    <h1><span class="underlined">Empowerin</span>g Your Business Growth</h1>

    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>
    <div class="buttons">
      <Button variant="accent"> Book a meeting </Button>
      <Button variant="default">Learn more <Arrow class="arrow" /></Button>
    </div>
  </div>

  <Image src={CEOImage} alt="CEO" class="hero-image" />

  <Services class="hero-cards" />
</section>
<style>
  @layer components {
    .hero {
      display: grid;
      overflow: hidden;
      grid-template-columns:
        [full-start] 1fr
        [content-start] minmax(0, 600px)
        [middle] minmax(0, 600px) [content-end]
        1fr [full-end];
      grid-template-rows:
        [nav-start] 0
        [text-start] auto
        [text-end cards-start] auto
        [cards-end];
    }

    h1 {
      color: var(--color-on-ui-primary);
      position: relative;
      width: fit-content;
      text-underline-offset: 3px;
      text-box: cap alphabetic;

      &::before {
        content: "";
        position: absolute;
        right: 100%;
        width: 100vw;
        top: calc(1cap + 3px);
        height: 3px;
        background: linear-gradient(to left, #ffcc4a, #0000 12rem);
      }
    }

    .underlined {
      text-decoration: underline #ffcc4a 3px;
      text-underline-offset: 3px;
    }

    p {
      color: var(--color-on-ui-primary-muted);
    }

    .buttons {
      display: flex;
      gap: var(--space-4);
    }

    .hero-background {
      grid-column: full-start / middle;
      grid-row: text-start / cards-start;
      background-color: var(--color-surface-highlight);
      --pattern-color: #ffcc4a;
      background:
        radial-gradient(ellipse farthest-side at 65% 35%, #0000, #000),
        conic-gradient(
            from 180deg at 1px 1px,
            alpha(from var(--pattern-color) / 0.35) 75%,
            #0000 0
          ) -1px -1px /
          80px 80px,
        #000;
    }

    .hero-content {
      grid-column: content-start / middle;
      grid-row: text-start / cards-start;
      position: relative;
      display: flex;
      z-index: 1;
      flex-direction: column;
      justify-content: center;
      gap: var(--space-6);
      max-width: 508px;
      min-height: 330px;
      padding-block-end: 8rem;
    }

    .hero-image {
      grid-column: middle / full-end;
      grid-row: nav-start / cards-start;
      width: 100%;
      height: 100%;
      object-fit: cover;
      overflow: hidden;
    }

    :global(.hero-cards) {
      grid-column: content-start / content-end;
      grid-row: cards-start / cards-end;
      transform: translateY(-50%);
    }

    .arrow {
      color: #f3f4f6;
      width: 1rem;
      height: 0.8rem;
    }

    @media (max-width: 56rem) {
      .hero {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto auto auto;
      }

      .hero-background {
        grid-area: 1 / 1;
      }

      .hero-content {
        grid-area: 1 / 1;
        justify-content: flex-start;
        max-width: none;
        min-height: 0;
        padding: 3rem 1rem;
      }

      h1 {
        font-size: clamp(2rem, 9vw, var(--text-size-xxxl));
      }

      .buttons {
        flex-wrap: wrap;
      }

      .hero-image {
        grid-area: 2 / 1;
        height: 16rem;
        object-position: center 20%;
      }

      :global(.hero-cards) {
        grid-area: 3 / 1;
        transform: none;
        padding: 1.5rem 1rem 2rem;
      }
    }
  }
</style>
