---
import { Image } from "astro:assets";
import Services from "./Services.astro";
import CEOImage from "@assets/images/ceo.webp";
import Button from "../components/Button.astro";
import Arrow from "../icons/arrow--right.svg";
---

<section class="hero">
  <div class="hero-content">
    <h1>Empowering Your Business Growth</h1>
    <p>
      Discover tailored strategies and expert insights to take your business to
      the next level. Let us help you navigate challenges and achieve
      sustainable success.
    </p>

    <Button variant="accent"> Book a meeting </Button>
    <Button variant="default">Learn more <Arrow class="arrow" /></Button>
  </div>

  <Image src={CEOImage} alt="CEO" />

  <Services />
</section>

<style>
  @layer components {
    .hero {
      background-color: #f3f4f6;
      padding: 2rem;
    }

    .arrow {
      color: #f3f4f6;
      width: 1rem;
      height: 0.8rem;
    }

    /* mønster til baggrund ved siden af hero billede 
