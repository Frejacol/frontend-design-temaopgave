---
const { theme, variant, fullChild } = Astro.props;
---

<section data-theme={theme} class={variant}>
  <div class:list={["inner", { full: fullChild }]}>
    <slot />
  </div>
</section>

<style>
  [data-theme] {
    background: var(--bg-theme);
  }

  [data-theme="yellow"] {
    --bg-theme: var(--color-surface-highlight);
    padding-block: 6rem;
    border: 1px solid var(--color-ui-primary);
  }
  [data-theme="grey"] {
    --bg-theme: var(--color-surface-secondary);
  }
  section {
    padding-block: var(--space-10);
  }

  .full {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: full;
    > :global(*) {
      grid-column: content;
    }
  }
</style>
