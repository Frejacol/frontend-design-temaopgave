---
const { theme, variant, fullChild } = Astro.props;
---

<section data-theme={theme} class={variant}>
  <div class:list={["inner", { full: fullChild }]}>
    <slot />
  </div>
</section>

<style>
  @layer components {
    [data-theme] {
      background: var(--bg-theme);
    }

    [data-theme="yellow"] {
      --bg-theme: var(--color-surface-highlight);
      padding-block: 6rem;
      border: 1px solid var(--color-ui-primary);
    }

    [data-theme="grey"] {
      --bg-theme: var(--color-surface-secondary);
      .button {
        background-color: var(--color-ui-primary);
        color: var(--color-surface-secondary);
      }
    }

    [data-theme="dark"] {
      --bg-theme: var(--color-surface-highlight);
      --pattern-color: #ffcc4a;
      background:
        radial-gradient(ellipse farthest-side at 65% 35%, #0000, #000),
        conic-gradient(
            from 180deg at 1px 1px,
            alpha(from var(--pattern-color) / 0.35) 75%,
            #0000 0
          ) -1px -1px /
          80px 80px,
        #000;
      color: var(--color-surface-secondary);
      :global(.sub) {
        color: var(--color-surface-secondary);
      }
      :global(.cards) {
        color: var(--color-text);
      }
    }

    section {
      padding-block: var(--space-10);
    }

    .full {
      display: grid;
      grid-template-columns: subgrid;
      grid-column: full;
      > :global(*) {
        grid-column: content;
      }
    }
  }
</style>
