---
const { theme, variant } = Astro.props;
---

<section data-theme={theme} class={variant}><div><slot /></div></section>

<style>
  [data-theme] {
    background: var(--bg-theme);
  }

  [data-theme="yellow"] {
    --bg-theme: var(--color-surface-highlight);
  }

  section {
    padding: var(--space-10);
  }
</style>
