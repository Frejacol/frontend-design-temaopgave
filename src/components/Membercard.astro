---
import DynamicIcon from "@components/helpers/DynamicIcon.astro";
import { Image } from "astro:assets";
const { employer } = Astro.props;
---

<article>
  <div class="media">
    <Image
      style={`view-transition-name: img-${employer.slug}`}
      src={employer.image.src}
      alt=""
      width={employer.image.width}
      height={employer.image.height}
    />
    <p class="title">{employer.title}</p>
  </div>

  <div class="content">
    <h3>
      <a href={`/team/${employer.slug}`}>{employer.name}</a>
    </h3>
    <p class="teamDescription">{employer.description}</p>
  </div>

  <div class="socials">
    {
      employer.social_links.map((s: any) => (
        <a href={s.url}>
          <DynamicIcon name={s.icon} />
        </a>
      ))
    }
  </div>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }

  .media {
    position: relative;
    width: 100%;
  }

  .media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--border-card);
  }

  .title {
    position: absolute;
    right: 1.5ex;
    bottom: 1.5ex;
    padding: 0.5ex 1ex;
    border-radius: 2rem;
    background: var(--color-ui-primary);
    color: var(--color-on-ui-primary);
    font-size: 1em;
  }

  .content {
    padding: var(--space-4);
    text-align: center;
  }

  .teamDescription {
    color: var(--color-text-muted);
  }

  a {
    text-decoration: none;
    color: var(--color-text);
  }

  .socials {
    display: flex;
    flex-direction: row;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
</style>
