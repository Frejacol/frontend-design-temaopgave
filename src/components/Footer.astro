---
import "@styles/main.css";
---

<footer>
  <div>
    <p class="logo">Ask<span>Experts</span></p>
    <p class="small copyright">©2026 Consultalk. All rights reserved</p>
    <ul class="small legal">
      <li><a href="/">Terms of Service</a></li>
      <li><a href="/">Privacy Policy</a></li>
    </ul>
  </div>
</footer>

<style>
  @layer components {
    footer {
      background-color: var(--color-ui-primary);

      div {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        column-gap: 1rem;
        padding: 1em 2em;
        align-items: center;

        .logo {
          font-weight: 600;
          color: var(--color-on-ui-primary);
          font-size: 1.5rem;

          span {
            color: var(--color-action);
          }
        }

        .small {
          color: var(--color-text-weak);
          font-size: 1rem;
        }

        .copyright {
          text-align: center;
        }

        .legal {
          display: flex;
          justify-self: end;
          list-style: none;
          padding: 0;
          margin: 0;

          li:not(:last-child)::after {
            content: " | ";
            white-space: pre;
          }

          a {
            color: inherit;
            text-decoration: none;

            &:hover {
              color: var(--color-on-ui-primary);
            }
          }
        }

        @media (max-width: 600px) {
          display: flex;
          flex-direction: column;
          align-items: flex-start;
          gap: 0.75rem;
          padding: 2em 1em;

          .legal {
            flex-direction: column;
            gap: 0.25rem;

            li:not(:last-child)::after {
              content: none;
            }
          }

          .copyright {
            order: 3;
            text-align: start;
            font-size: 0.875rem;
            border-top: 1px solid #2b3a58;
            padding-top: 0.75rem;
            width: 100%;
          }
        }
      }
    }
  }
</style>
