---
const { figText } = Astro.props;
const { figNumber } = Astro.props;
---

<figure data-value={figNumber}>
  <svg viewBox="0 0 100 100">
    <circle cx="50" cy="50" r="48" class="track"></circle>
    <circle class="progress" pathLength="100"></circle>
    <circle class="marker" pathLength="100" r="5" fill="black"></circle>
  </svg>
  <figcaption>{figText}</figcaption>
</figure>

<style>
  @property --total {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  figure {
    flex: 0 0 200px;
    min-inline-size: 0;
    text-align: center;
    container: stat / inline-size;

    --value: attr(data-value type(<number>));
    --value-string: attr(data-value);
    --value-percent: attr(data-value %);

    --total: calc display: grid;
    grid: "stack";
    place-items: center;
    font-family: var(--font-cabin);
  }

  figure::after {
    content: var(--value-string) "%";
    grid-area: stack;
    font-size: var(--text-size-xxxl);
    font-weight: 700;
  }

  svg {
    rotate: -90deg;
    grid-area: stack;
    overflow: visible;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
  }

  .track {
    stroke: #daae3c;
  }

  .track,
  .progress {
    cx: 50; /* virker ikke i safari */
    cy: 50; /* virker ikke i safari */
    r: 46;
    fill: none;
    stroke-width: 3;
  }

  .progress {
    stroke: var(--color-surface-primary);
    stroke-linecap: round;
    stroke-dasharray: 100;
    /* stroke-dashoffset: calc(100 - var(--value)); */
    stroke-dashoffset: var(--total);
  }

  .marker {
    visibility: visible;
    stroke: var(--color-surface-primary);
    offset-path: circle(46px at 50px 50px);
    offset-distance: var(--value-percent);
    stroke-width: 3;
  }

  figcaption {
    margin-block-start: 0.75rem;
    font-size: var(--text-size-m);
  }
</style>
